# VisionBridge AI - Environment Configuration
# Copy this file to .env and customize values as appropriate.
# NEVER commit real credentials to version control.

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.5
UNCERTAINTY_THRESHOLD=0.35

# Vision & Camera
CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS_TARGET=30

# Speech & Accessibility
SPEECH_RATE=165
SPEECH_VOLUME=1.0
TTS_ENGINE=pyttsx3
STT_TIMEOUT_SECONDS=5
STT_PHRASE_TIME_LIMIT=10

# Cloud & AWS Integration (User Consent Required)
# Note: Local-first architecture; cloud features are opt-in with explicit user consent.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=visionbridge-accessibility-assets
AWS_LAMBDA_FUNCTION_NAME=visionbridge-scene-analysis
AWS_USE_MOCK=true
